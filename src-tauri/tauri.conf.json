{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraTask",
  "version": "1.0.4",
  "identifier": "com.nas.todo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AuraTask · 极简待办与专注",
        "width": 1120,
        "height": 740,
        "minWidth": 320,
        "minHeight": 320,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDRUY1NEExMzgxNzg1MjQKUldRa2hSYzRvVlR2ZkV0dmpvajhudGloVTVFd1FzRkNOQmhnQVJYOUlObFJpZWdHT0haNWZCRnIK",
      "endpoints": [
        "https://github.com/ht176/AuraTask/releases/latest/download/latest.json"
      ]
    }
  }
}
